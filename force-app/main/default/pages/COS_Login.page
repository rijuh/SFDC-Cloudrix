<apex:page controller="COS_LoginController" showHeader="false" sidebar="false" standardStylesheets="false"
    docType="html-5.0">

    <html>

    <head>

        <title>Cloudrix Online Support - Login</title>

        <!-- Bootstrap -->
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css" rel="stylesheet" />

        <!-- Google Font -->
        <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap"
            rel="stylesheet" />

        <!-- Bootstrap Icons -->
        <link rel="stylesheet"
            href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

        <style>
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            body {

                font-family: 'Poppins', sans-serif;

                background: linear-gradient(135deg, #eef5ff, #ffffff);

                height: 100vh;

                overflow: hidden;

            }

            .left-panel {

                height: 100vh;

                display: flex;

                justify-content: center;

                align-items: center;

                padding: 80px;

            }

            .brand h1 {

                color: #0176D3;

                font-size: 70px;

                font-weight: 700;

            }

            .brand h2 {

                font-size: 45px;

                font-weight: 500;

                color: #222;

            }

            .brand p {

                margin-top: 30px;

                color: #555;

                font-size: 22px;

            }

            .logo {

                width: 90px;

                height: 90px;

                border-radius: 50%;

                background: #0176D3;

                color: white;

                display: flex;

                justify-content: center;

                align-items: center;

                font-size: 38px;

                font-weight: bold;

                margin-bottom: 30px;

            }

            .illustration {

                font-size: 160px;

                color: #0176D3;

                margin-top: 60px;

            }

            .copyright {

                margin-top: 30px;

                color: #777;

                font-size: 14px;

            }

            .right-panel {

                display: flex;

                justify-content: center;

                align-items: center;

                height: 100vh;

            }

            .login-card {

                width: 500px;

                background: white;

                border-radius: 25px;

                padding: 45px;

                box-shadow: 0px 15px 40px rgba(0, 0, 0, .15);

            }

            .login-card h2 {

                text-align: center;

                font-weight: 700;

                margin-bottom: 10px;

            }

            .login-card p {

                text-align: center;

                color: #777;

                margin-bottom: 30px;

            }

            .form-control {

                height: 55px;

                border-radius: 12px;

            }

            .btn-login {

                background: #0176D3;

                color: white;

                height: 55px;

                border-radius: 12px;

                font-size: 18px;

                font-weight: 600;

            }

            .btn-login:hover {

                background: #015fb0;

                color: white;

            }

            .divider {

                text-align: center;

                margin: 30px 0;

                color: #777;

            }

            .register-btn {
                margin: 0;
                padding: 0;

                border-radius: 12px;

                height: 55px;

                font-weight: 600;

            }

            a {

                text-decoration: none;

            }

            .create-account {
                height: 70px;
                border: 2px solid #0d6efd;
                border-radius: 20px;

                display: flex;
                justify-content: center;
                /* Horizontal center */
                align-items: center;
                /* Vertical center */
                cursor: pointer;
            }

            .create-account h2 {
                margin: 0;
                color: #0d6efd;
                font-size: 18px;
                font-weight: 700;
            }
        </style>

    </head>

    <body>

        <div class="container-fluid">

            <div class="row">

                <!-- LEFT PANEL -->

                <div class="col-lg-6 left-panel">
                    <div class="brand">
                        <div class="logo">
                            COS
                        </div>
                        <h1>Cloudrix</h1>
                        <h2>Online Support</h2>
                        <p>
                            Welcome Back!<br />
                            Sign in to manage your support requests.
                        </p>
                        <div class="illustration">
                            <i class="bi bi-headset"></i>
                        </div>
                        <div class="copyright">
                            © 2026 Cloudrix Online Support
                        </div>
                    </div>
                </div>

                <!-- RIGHT PANEL -->

                <div class="col-lg-6 right-panel">

                    <div class="login-card">

                        <h2>Welcome Back</h2>

                        <p>Login to continue</p>

                        <apex:outputPanel id="messages">
                            <!-- Success Message -->
                            <apex:outputPanel rendered="{!NOT(ISBLANK(successMessage))}">
                                <div class="alert alert-success d-flex align-items-center mb-4">
                                    <i class="bi bi-check-circle-fill me-2"></i>
                                    <span>{!successMessage}</span>
                                </div>
                            </apex:outputPanel>
                        </apex:outputPanel>

                        <apex:form >

                            <div class="mb-3">

                                <label>Email Address</label>

                                <apex:inputText value="{!username}" styleClass="form-control"
                                    html-placeholder="Enter your email" />

                            </div>

                            <div class="mb-3">

                                <label>Password</label>

                                <apex:inputSecret value="{!password}" styleClass="form-control"
                                    html-placeholder="Enter your password" />

                            </div>

                            <div class="d-flex justify-content-between mb-4">

                                <div>

                                    <input type="checkbox" />

                                    Remember Me

                                </div>

                                <a href="#">

                                    Forgot Password?

                                </a>

                            </div>

                            <apex:commandButton value="LOGIN" action="{!login}" styleClass="btn btn-login w-100" />

                            <div class="divider">

                                ──────── OR ────────

                            </div>

                            <div class="create-account">
                                <a href="/apex/COS_Register">
                                    Create New Account
                                </a>
                            </div>

                        </apex:form>

                    </div>

                </div>

            </div>

        </div>

        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js"></script>
        
        <script>
            window.onload = function () {
                const alert = document.querySelector(".alert-success");
                if (alert) {
                    setTimeout(() => {
                        alert.style.transition = "opacity 0.5s";
                        alert.style.opacity = "0";
                        setTimeout(() => alert.remove(), 500);
                    }, 5000);
                }
            };
        </script>

    </body>

    </html>

</apex:page>