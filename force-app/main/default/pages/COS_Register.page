<apex:page controller="COS_RegisterController" showHeader="false" sidebar="false" standardStylesheets="false"
    docType="html-5.0">

    <title>Cloudrix Online Support - Login</title>

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css" rel="stylesheet" />

    <!-- Google Font -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap"
        rel="stylesheet" />

    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {

            font-family: 'Poppins', sans-serif;

            background: linear-gradient(135deg, #eef5ff, #ffffff);

            height: 100vh;

            overflow: hidden;

        }

        .left-panel {

            height: 100vh;

            display: flex;

            justify-content: center;

            align-items: center;

            padding: 80px;

        }

        .brand h1 {

            color: #0176D3;

            font-size: 70px;

            font-weight: 700;

        }

        .brand h2 {

            font-size: 45px;

            font-weight: 500;

            color: #222;

        }

        .brand p {

            margin-top: 30px;

            color: #555;

            font-size: 22px;

        }

        .logo {

            width: 90px;

            height: 90px;

            border-radius: 50%;

            background: #0176D3;

            color: white;

            display: flex;

            justify-content: center;

            align-items: center;

            font-size: 38px;

            font-weight: bold;

            margin-bottom: 30px;

        }

        .illustration {

            font-size: 160px;

            color: #0176D3;

            margin-top: 60px;

        }

        .copyright {

            margin-top: 30px;

            color: #777;

            font-size: 14px;

        }

        .right-panel {

            display: flex;

            justify-content: center;

            align-items: center;

            height: 100vh;

        }

        .register-card {

            width: 500px;

            background: white;

            border-radius: 25px;

            padding: 45px;

            box-shadow: 0px 15px 40px rgba(0, 0, 0, .15);

        }

        .register-card h2 {

            text-align: center;

            font-weight: 700;

            margin-bottom: 10px;

        }

        .register-card p {

            text-align: center;

            color: #777;

            margin-bottom: 30px;

        }

        .form-control {

            height: 55px;

            border-radius: 12px;

        }

        .btn-register {

            background: #0176D3;

            color: white;

            height: 55px;

            border-radius: 12px;

            font-size: 18px;

            font-weight: 600;

        }

        .btn-register:hover {

            background: #015fb0;

            color: white;

        }

        .register-btn {
            margin: 0;
            padding: 0;

            border-radius: 12px;

            height: 55px;

            font-weight: 600;

        }

        a {

            text-decoration: none;

        }

        .create-account {
            height: 70px;
            border: 2px solid #0d6efd;
            border-radius: 20px;

            display: flex;
            justify-content: center;
            /* Horizontal center */
            align-items: center;
            /* Vertical center */
            cursor: pointer;
        }

        .create-account h2 {
            margin: 0;
            color: #0d6efd;
            font-size: 18px;
            font-weight: 700;
        }

        .login-link {
            text-align: center;
            margin-top: 25px;
        }

        .login-link a {
            text-decoration: none;
            color: #0d6efd;
            font-weight: 600;
        }

        .login-link a:hover {
            text-decoration: underline;
        }
    </style>


    <div class="container-fluid">

        <div class="row">

            <!-- LEFT PANEL -->

            <div class="col-lg-6 left-panel">
                <div class="brand">
                    <div class="logo">
                        COS
                    </div>
                    <h1>Cloudrix</h1>
                    <h2>Online Support</h2>
                    <p>
                        Join Cloudrix and manage your account securely from anywhere.
                        <br />
                        Create your account to get started.
                    </p>
                    <div class="copyright">
                        © 2026 Cloudrix Online Support
                    </div>
                </div>
            </div>

            <!-- RIGHT PANEL -->

            <div class="col-lg-6 right-panel">

                <div class="register-card">

                    <h2>Create New Account</h2>

                    <apex:outputPanel id="messages">
                        <!-- Error Message -->
                        <apex:outputPanel rendered="{!NOT(ISBLANK(errorMessage))}">
                            <div class="alert alert-danger d-flex align-items-center mb-4">
                                <i class="bi bi-exclamation-circle-fill me-2"></i>
                                <span>{!errorMessage}</span>
                            </div>
                        </apex:outputPanel>

                        <!-- Success Message -->
                        <apex:outputPanel rendered="{!NOT(ISBLANK(successMessage))}">
                            <div class="alert alert-success d-flex align-items-center mb-4">
                                <i class="bi bi-check-circle-fill me-2"></i>
                                <span>{!successMessage}</span>
                            </div>
                        </apex:outputPanel>
                    </apex:outputPanel>

                    <apex:form id="registerForm">

                        <div class="mb-3">
                            <label class="form-label">Full Name</label>
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <apex:inputText value="{!firstName}" styleClass="form-control"
                                        html-placeholder="First Name" />
                                </div>
                                <div class="col-md-6">
                                    <apex:inputText value="{!lastName}" styleClass="form-control"
                                        html-placeholder="Last Name" />
                                </div>
                            </div>
                        </div>

                        <div class="mb-3">

                            <label>Email Address</label>

                            <apex:inputText value="{!email}" styleClass="form-control"
                                html-placeholder="Enter your email" />

                        </div>
                        <div class="mb-3">

                            <label>Password</label>

                            <apex:inputSecret value="{!password}" styleClass="form-control"
                                html-placeholder="Enter your password" />

                        </div>

                        <apex:commandButton value="REGISTER" action="{!register}" rerender="messages"
                            styleClass="btn btn-register w-100" />

                        <div class="login-link">

                            Already have an account?

                            <a href="{!URLFOR($Page.COS_Login)}">
                                Login
                            </a>

                        </div>

                    </apex:form>

                </div>

            </div>

        </div>

    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js"></script>

</apex:page>